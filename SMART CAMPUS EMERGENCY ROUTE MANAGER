    c.addLocation("Law_Dept", false);
    c.addLocation("Mini_Park", false);
    c.addLocation("Account_Office", false);
    c.addLocation("Canteen", false);
    c.addLocation("Girls_Hostel", false);      // Kalpana Chawla Hostel
    c.addLocation("Main_Ground", true);        // assembly point
    c.addLocation("Pharmacy_Dept", false);
    c.addLocation("Main_Entrance", true);      // exit
    c.addLocation("Entrance_2", true);         // exit (2nd entrance)
    c.addLocation("Entrance_3", true);         // exit (3rd entrance)
    c.addLocation("Small_Canteen", false);
    c.addLocation("Library", false);
    c.addLocation("Boys_Hostel", false);

    // ----- road from Main Gate down to the hostel corner -----
    c.addPath("Main_Gate", "Law_Dept", 35);
    c.addPath("Law_Dept", "Mini_Park", 50);
    c.addPath("Mini_Park", "Account_Office", 20);
    c.addPath("Account_Office", "Canteen", 45);
