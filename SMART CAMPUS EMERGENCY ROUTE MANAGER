// ============================================================
//  Main (menu)
// ============================================================
void printMenu() {
    cout << "===== SMART CAMPUS EMERGENCY ROUTE MANAGER =====\n"
         << "1. Show campus map\n"
         << "2. Shortest safe route between two places\n"
         << "3. Nearest exit from a location\n"
         << "4. Block a path\n"
         << "5. Undo last block\n"
         << "6. Report incident\n"
         << "7. Process most severe incident\n"
         << "8. Clear hazard (all-clear)\n"
         << "9. Check locations cut off from exits\n"
         << "0. Save and quit\n"
         << "(Names are not case-sensitive: 'main gate' works too)\n";
}

int main() {
    Campus campus;
    IncidentList incidents;     // priority queue (sorted linked list)
    Stack undoStack;            // blocked paths for undo

    // Load saved data; if there is no usable file, start with the default map
    string notice;
    if (loadAll(campus, incidents)) {
        campus.collectBlocked(undoStack);
        notice = "Saved data loaded from campus_data.txt";
        int h = campus.hazardCount(), b = campus.blockedCount();
        if (h > 0 || b > 0) {
            ostringstream warn;
            warn << "\n WARNING - still active from last time: " << h << " hazard place(s), "
                 << b << " blocked road(s).\n Option 8 clears hazards, option 5 reopens roads.";
            notice += warn.str();
        }
    } else {
        campus.clearAll();
        incidents.clear();
        loadSample(campus);
        saveAll(campus, incidents);
        notice = "Started with the default campus map (saved to campus_data.txt)";
    }

    while (true) {
        clearScreen();
        if (!notice.empty()) { cout << "[" << notice << "]\n\n"; notice = ""; }
        printMenu();
        cout << "\nChoice: ";

        string line;
        if (!getline(cin, line)) break;                  // input closed
        int choice;
        if (!parseInt(line, choice)) choice = -1;        // not a number

        if (choice == 0) {
            clearScreen();
            cout << (saveAll(campus, incidents) ? "Data saved. " : "[!] Could not save data. ")
                 << "Stay safe. Goodbye!\n";
            break;
        }

        clearScreen();                                   // wipe the menu, show only this task
        bool changed = false;

        if (choice == 1) {
            cout << "----- CAMPUS MAP -----\n";
            campus.showMap();
        }
        else if (choice == 2) {
            cout << "----- SHORTEST SAFE ROUTE -----\n";
            int s = campus.getId(ask("  From: "));
            int t = (s == -1) ? -1 : campus.getId(ask("  To: "));
            if (s != -1 && t != -1) campus.shortestPath(s, t);
        }
        else if (choice == 3) {
            cout << "----- NEAREST EXIT -----\n";
            int s = campus.getId(ask("  Your location: "));
            if (s != -1) campus.nearestExit(s);
        }
        else if (choice == 4) {
            cout << "----- BLOCK A PATH -----\n"
                 << "  (Type two places that are directly connected - see option 1)\n";
            int u = campus.getId(ask("  Path end 1: "));
            int v = (u == -1) ? -1 : campus.getId(ask("  Path end 2: "));
            if (u != -1 && v != -1) {
                if (campus.setBlockedById(u, v, true)) {
                    undoStack.push(u, v);
                    changed = true;
                    cout << "  Path blocked: " << campus.nameOf(u) << " <-> " << campus.nameOf(v) << "\n";
                } else {
                    cout << "  [!] No direct path between them.\n";
                }
            }
        }
        else if (choice == 5) {
            cout << "----- UNDO LAST BLOCK -----\n";
            if (undoStack.isEmpty()) {
                cout << "  Nothing to undo.\n";
            } else {
                BlockedPath p = undoStack.pop();
                campus.setBlockedById(p.a, p.b, false);
                changed = true;
                cout << "  Undo: reopened " << campus.nameOf(p.a) << " <-> " << campus.nameOf(p.b) << "\n";
            }
        }
        else if (choice == 6) {
            cout << "----- REPORT INCIDENT -----\n"
                 << "  (This only stores the incident. Use option 7 to handle it.)\n";
            int id = campus.getId(ask("  Location: "));
            if (id != -1) {
                string type = capitalize(normalize(ask("  Type (Fire/Flood/Gas leak...): ")));
                int sev;
                if (type.empty()) type = "Unknown";
                if (!parseInt(ask("  Severity (1-10): "), sev) || sev < 1 || sev > 10) {
                    cout << "  [!] Severity must be a number from 1 to 10.\n";
                } else {
                    incidents.insert(campus.nameOf(id), type, sev);
                    changed = true;
                    cout << "  Incident reported. Pending: " << incidents.size() << "\n";
                }
            }
        }
        else if (choice == 7) {
            cout << "----- PROCESS MOST SEVERE INCIDENT -----\n";
            string loc, type;
            int sev;
            if (!incidents.removeFirst(loc, type, sev)) {
                cout << "  No pending incidents.\n";
            } else {
                int id = campus.findId(loc);
                cout << "  >> Handling: " << type << " at " << loc
                     << " (severity " << sev << ")\n";
                writeLog(loc, type, sev);
                campus.setHazardById(id, true);
                changed = true;
                cout << "  " << loc << " marked HAZARD. Others will avoid it.\n"
                     << "  Evacuation route for people inside:\n";
                campus.nearestExit(id);
                cout << "  Remaining incidents: " << incidents.size() << "\n";
            }
        }
        else if (choice == 8) {
            cout << "----- CLEAR HAZARD -----\n";
            int id = campus.getId(ask("  Location: "));
            if (id != -1) {
                campus.setHazardById(id, false);
                changed = true;
                cout << "  Hazard cleared at " << campus.nameOf(id) << ".\n";
            }
        }
        else if (choice == 9) {
            cout << "----- CUT-OFF CHECK -----\n";
            campus.checkCutOff();
        }
        else {
            cout << "  [!] Invalid choice. Enter a number from 0 to 9.\n";
        }

        if (changed && !saveAll(campus, incidents))
            cout << "  [!] Could not save to " << DATA_FILE << "\n";

        pauseScreen();
    }

    return 0;
}
