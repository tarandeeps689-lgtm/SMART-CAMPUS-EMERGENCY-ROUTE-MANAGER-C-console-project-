// ============================================================
//  DS 1: Linked list node (one node = one path from a location)
// ============================================================
struct EdgeNode {
    int to;            // destination location id
    int weight;        // distance in metres
    bool blocked;      // true if path is blocked
    EdgeNode *next;    // next path in the list
};

// ============================================================
//  DS 2: Stack using an array (stores blocked paths for undo)
// ============================================================
struct BlockedPath {
    int a, b;
};

class Stack {
    BlockedPath data[50];
    int top;
public:
    Stack() { top = -1; }
    bool isEmpty() const { return top == -1; }
    bool isFull() const { return top == 49; }
    void push(int a, int b) {
        if (isFull()) return;
        top++;
        data[top].a = a;
        data[top].b = b;
    }
    BlockedPath pop() {          // call only if not empty
        return data[top--];
    }
};

// ============================================================
//  DS 3: Queue using an array (used in BFS)
// ============================================================
class Queue {
    int data[MAX];
    int front, rear;
public:
    Queue() { front = 0; rear = 0; }
    bool isEmpty() const { return front == rear; }
    void enqueue(int x) { data[rear++] = x; }
    int dequeue() { return data[front++]; }
};

// ============================================================
//  DS 4: Priority queue using a sorted linked list
//        (highest severity is always at the front)
// ============================================================
struct IncidentNode {
    string location;
    string type;
    int severity;
    IncidentNode *next;
};

class IncidentList {
    IncidentNode *head;
    int count;
    IncidentList(const IncidentList &);              // not copyable
    IncidentList &operator=(const IncidentList &);
public:
    IncidentList() { head = NULL; count = 0; }
    ~IncidentList() { clear(); }

    void clear() {
        while (head != NULL) {
            IncidentNode *t = head;
            head = head->next;
            delete t;
        }
        count = 0;
    }

    int size() const { return count; }

    // Insert so that the list stays sorted (highest severity first)
    void insert(const string &loc, const string &type, int sev) {
        IncidentNode *n = new IncidentNode;
        n->location = loc;
        n->type = type;
        n->severity = sev;

        if (head == NULL || sev > head->severity) {      // goes at the front
            n->next = head;
            head = n;
        } else {                                         // find its position
            IncidentNode *cur = head;
            while (cur->next != NULL && cur->next->severity >= sev)
                cur = cur->next;
            n->next = cur->next;
            cur->next = n;
        }
        count++;
    }

    // Remove the most severe incident; returns false if list is empty
    bool removeFirst(string &loc, string &type, int &sev) {
        if (head == NULL) return false;
        IncidentNode *t = head;
        loc = t->location;
        type = t->type;
        sev = t->severity;
        head = head->next;
        delete t;
        count--;
        return true;
    }

    // File handling: one line per pending incident (in priority order)
    void writeTo(ostream &out) const {
        for (IncidentNode *p = head; p != NULL; p = p->next)
            out << "I " << p->location << " " << p->type << " " << p->severity << "\n";
    }
};

// ============================================================
//  Campus = Graph (adjacency list made of linked lists)
// ============================================================
class Campus {
    string names[MAX];
    bool isExit[MAX];
    bool hazard[MAX];          // true if location is unsafe (fire etc.)
    EdgeNode *head[MAX];       // head[i] = linked list of paths from location i
    int n;                     // number of locations

    Campus(const Campus &);              // not copyable (raw pointers inside)
    Campus &operator=(const Campus &);

    void addEdge(int u, int v, int w) {  // insert at the front of the list
        EdgeNode *e = new EdgeNode;
        e->to = v;
        e->weight = w;
        e->blocked = false;
        e->next = head[u];
        head[u] = e;
    }

    // Dijkstra: fills dist[] and parent[] for every location from src.
    // safeOnly = true  -> blocked paths and hazard locations are skipped.
    // safeOnly = false -> they are ignored (used only to show an UNSAFE route as a warning).
    void dijkstra(int src, int dist[], int parent[], bool safeOnly) const {
        bool done[MAX];
        for (int i = 0; i < n; i++) {
            dist[i] = INF;
            parent[i] = -1;
            done[i] = false;
        }
        dist[src] = 0;

        for (int count = 0; count < n; count++) {
            // pick the unvisited location with the smallest distance
            int u = -1;
            for (int i = 0; i < n; i++)
                if (!done[i] && dist[i] < INF && (u == -1 || dist[i] < dist[u]))
                    u = i;
            if (u == -1) break;              // remaining locations unreachable
            done[u] = true;

            // relax all paths going out of u
            for (EdgeNode *e = head[u]; e != NULL; e = e->next) {
                if (safeOnly && (e->blocked || hazard[e->to])) continue;
                if (dist[u] + e->weight < dist[e->to]) {
                    dist[e->to] = dist[u] + e->weight;
                    parent[e->to] = u;
                }
            }
        }
    }

    void printPath(const int parent[], int v) const {   // recursion prints path from source
        if (parent[v] != -1) {
            printPath(parent, parent[v]);
            cout << " -> ";
        }
        cout << names[v];
        if (parent[v] != -1 && hazard[v]) cout << " [HAZARD]";
    }

    bool roadBlocked(int u, int v) const {
        for (EdgeNode *e = head[u]; e != NULL; e = e->next)
            if (e->to == v) return e->blocked;
        return false;
    }

public:
    Campus() { n = 0; }
    ~Campus() { clearAll(); }

    void clearAll() {                        // free all linked-list nodes
        for (int i = 0; i < n; i++) {
            while (head[i] != NULL) {
                EdgeNode *t = head[i];
                head[i] = head[i]->next;
                delete t;
            }
        }
        n = 0;
    }

    int size() const { return n; }
    const string &nameOf(int id) const { return names[id]; }

    // Finds a location ignoring upper/lower case and spaces. -1 if not found.
    int findId(const string &input) const {
        string key = normalize(input);
        for (int i = 0; i < n; i++)
            if (toLower(names[i]) == key) return i;
        return -1;
    }

    int getId(const string &input) const {   // same, but prints an error
        int id = findId(input);
        if (id == -1)
            cout << "  [!] Unknown location: \"" << trim(input)
                 << "\"  (option 1 shows all names)\n";
        return id;
    }

    bool addLocation(const string &name, bool exitPoint) {
        if (n == MAX || findId(name) != -1) return false;
        names[n] = name;
        isExit[n] = exitPoint;
        hazard[n] = false;
        head[n] = NULL;
        n++;
        return true;
    }

    bool addPath(const string &a, const string &b, int dist) {
        int u = findId(a), v = findId(b);
        if (u == -1 || v == -1 || u == v || dist <= 0) return false;
        addEdge(u, v, dist);
        addEdge(v, u, dist);                 // paths are two-way
        return true;
    }

    // ---------- emergency controls ----------
    bool setBlockedById(int u, int v, bool state) {
        bool found = false;
        for (EdgeNode *e = head[u]; e != NULL; e = e->next)
            if (e->to == v) { e->blocked = state; found = true; }
        for (EdgeNode *e = head[v]; e != NULL; e = e->next)
            if (e->to == u) e->blocked = state;
        return found;
    }

    void setHazardById(int id, bool state) { hazard[id] = state; }

    int hazardCount() const {
        int c = 0;
        for (int i = 0; i < n; i++) if (hazard[i]) c++;
        return c;
    }

    int blockedCount() const {                           // each road counted once
        int c = 0;
        for (int u = 0; u < n; u++)
            for (EdgeNode *e = head[u]; e != NULL; e = e->next)
                if (u < e->to && e->blocked) c++;
        return c;
    }

    // After loading the file, put every blocked road on the undo stack
    // so that option 5 can reopen roads that were blocked in an earlier run.
    void collectBlocked(Stack &st) const {
        for (int u = 0; u < n; u++)
            for (EdgeNode *e = head[u]; e != NULL; e = e->next)
                if (u < e->to && e->blocked) st.push(u, e->to);
    }

    // ---------- features ----------
    void showMap() const {
        cout << "  Each line = one place and the places directly connected to it.\n"
             << "  [EXIT] safe exit/assembly point   [HAZARD] unsafe   [BLOCKED] path closed\n\n";
        for (int i = 0; i < n; i++) {
            string label = names[i];
            if (isExit[i]) label += " [EXIT]";
            if (hazard[i]) label += " [HAZARD]";
            cout << "  " << left << setw(26) << label << "-> ";
            for (EdgeNode *e = head[i]; e != NULL; e = e->next) {
                cout << names[e->to] << " (" << e->weight << " m)";
                if (e->blocked) cout << " [BLOCKED]";
                if (e->next != NULL) cout << ", ";
            }
            cout << "\n";
        }
    }

    void shortestPath(int s, int t) const {
        int dist[MAX], parent[MAX];
        dijkstra(s, dist, parent, true);                 // 1st try: safe roads only
        if (dist[t] != INF) {
            cout << "  Route: ";
            printPath(parent, t);
            cout << "\n  Total distance: " << dist[t] << " m\n";
            return;
        }

        dijkstra(s, dist, parent, false);                // 2nd try: ignore blocks and hazards
        if (dist[t] == INF) {
            cout << "  [!!] No road connects " << names[s] << " and " << names[t] << ".\n";
            return;
        }
        cout << "  [!!] NO SAFE ROUTE from " << names[s] << " to " << names[t] << ".\n"
             << "  The only way passes through unsafe areas (shown for information only):\n"
             << "  Route: ";
        printPath(parent, t);
        cout << "\n  Total distance: " << dist[t] << " m\n";
        for (int v = t; parent[v] != -1; v = parent[v])
            if (roadBlocked(parent[v], v))
                cout << "  Blocked road on this route: " << names[parent[v]] << " <-> " << names[v] << "\n";
        cout << "  Do NOT use it unless the rescue team allows it.\n"
             << "  To make it safe: option 5 reopens blocked roads, option 8 clears hazards.\n";
    }

    void nearestExit(int s) const {
        int dist[MAX], parent[MAX];
        dijkstra(s, dist, parent, true);

        int best = -1;                       // exit with the smallest distance
        for (int i = 0; i < n; i++)
            if (isExit[i] && dist[i] < INF && (best == -1 || dist[i] < dist[best]))
                best = i;

        if (best == -1) {
            cout << "  [!!] NO SAFE ROUTE to any exit from " << names[s] << "! Call rescue team.\n";
            return;
        }
        cout << "  Route: ";
        printPath(parent, best);
        cout << "\n  Total distance: " << dist[best] << " m\n";
    }

    // BFS starting from all exits together; locations not reached are cut off
    void checkCutOff() const {
        bool seen[MAX];
        Queue q;
        for (int i = 0; i < n; i++) {
            seen[i] = false;
            if (isExit[i] && !hazard[i]) {
                seen[i] = true;
                q.enqueue(i);
            }
        }
        while (!q.isEmpty()) {
            int u = q.dequeue();
            for (EdgeNode *e = head[u]; e != NULL; e = e->next) {
                if (e->blocked || hazard[e->to] || seen[e->to]) continue;
                seen[e->to] = true;
                q.enqueue(e->to);
            }
        }
        bool any = false;
        for (int i = 0; i < n; i++) {
            if (!seen[i] && !hazard[i]) {
                if (!any) cout << "  [!!] Locations CUT OFF from all exits:\n";
                cout << "      - " << names[i] << "\n";
                any = true;
            }
        }
        if (!any) cout << "  All safe locations can reach an exit.\n";
    }

    // ---------- file handling ----------
    // Line formats:  L name exit   |   P a b dist blocked   |   H name
    void writeTo(ostream &out) const {
        for (int i = 0; i < n; i++)
            out << "L " << names[i] << " " << (isExit[i] ? 1 : 0) << "\n";
        for (int u = 0; u < n; u++)
            for (EdgeNode *e = head[u]; e != NULL; e = e->next)
                if (u < e->to)                          // write each path once
                    out << "P " << names[u] << " " << names[e->to] << " "
                        << e->weight << " " << (e->blocked ? 1 : 0) << "\n";
        for (int i = 0; i < n; i++)
            if (hazard[i]) out << "H " << names[i] << "\n";
    }
};

// ============================================================
//  Save / load everything to campus_data.txt
// ============================================================
bool saveAll(const Campus &campus, const IncidentList &incidents) {
    ofstream out(DATA_FILE);
    if (!out) return false;
    out << "V 2\n";                                     // file version
    campus.writeTo(out);
    incidents.writeTo(out);
    return true;
}

// Reads the file line by line; each line is split into words with <sstream>.
// Returns false if the file is missing or damaged.
bool loadAll(Campus &campus, IncidentList &incidents) {
    ifstream in(DATA_FILE);
    if (!in) return false;

    string line;
    bool versionOk = false;
    while (getline(in, line)) {
        istringstream iss(line);
        string tag;
        if (!(iss >> tag)) continue;                    // blank line

        if (tag == "V") {
            int v;
            if (!(iss >> v) || v != 2) return false;    // old/unknown file format
            versionOk = true;
        } else if (tag == "L") {
            string name;
            int ex;
            if (!(iss >> name >> ex)) return false;
            if (!campus.addLocation(name, ex == 1)) return false;
        } else if (tag == "P") {
            string a, b;
            int d, bl;
            if (!(iss >> a >> b >> d >> bl)) return false;
            if (!campus.addPath(a, b, d)) return false;
            if (bl == 1) campus.setBlockedById(campus.findId(a), campus.findId(b), true);
        } else if (tag == "H") {
            string name;
            if (!(iss >> name)) return false;
            int id = campus.findId(name);
            if (id == -1) return false;
            campus.setHazardById(id, true);
        } else if (tag == "I") {
            string loc, type;
            int sev;
            if (!(iss >> loc >> type >> sev)) return false;
            if (campus.findId(loc) == -1) return false;
            incidents.insert(loc, type, sev);
        } else {
            return false;                               // unknown line
        }
    }
    return versionOk && campus.size() > 0;
}

// Appends one line to incident_log.txt
void writeLog(const string &loc, const string &type, int sev) {
    ofstream log(LOG_FILE, ios::app);
    if (!log) return;
    time_t now = time(0);
    char buf[32];
    strftime(buf, sizeof(buf), "%d-%m-%Y %H:%M", localtime(&now));
    log << buf << " | " << type << " at " << loc << " | severity " << sev << "\n";
}

// ============================================================
//  Default campus (based on our hand-drawn campus map)
//
//  Every place is a node. A line between two places is a path with
//  its walking distance in metres (measured along the road).
