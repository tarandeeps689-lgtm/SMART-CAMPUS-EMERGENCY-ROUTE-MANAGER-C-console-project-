const int MAX = 30;                           // maximum number of locations
const int INF = 1000000;                      // "infinite" distance
const char *const DATA_FILE = "campus_data.txt";
const char *const LOG_FILE = "incident_log.txt";

// ============================================================
//  Text helpers (use <sstream>)
// ============================================================
string trim(const string &s) {
    size_t a = s.find_first_not_of(" \t\r\n");
    if (a == string::npos) return "";
    size_t b = s.find_last_not_of(" \t\r\n");
    return s.substr(a, b - a + 1);
}

string toLower(string s) {
    for (size_t i = 0; i < s.size(); i++)
        s[i] = (char)tolower((unsigned char)s[i]);
    return s;
}

// "  Main   GATE " -> "main_gate"   (split into words, join with _, lowercase)
string normalize(const string &s) {
    istringstream iss(s);
    string word, result;
    while (iss >> word) {
        if (!result.empty()) result += "_";
        result += word;
    }
    return toLower(result);
}

// "fIRE" -> "Fire"
string capitalize(string s) {
    for (size_t i = 0; i < s.size(); i++)
        s[i] = (char)(i == 0 ? toupper((unsigned char)s[i]) : tolower((unsigned char)s[i]));
    return s;
}

// reads one whole number from a line; false if the line is not just a number
bool parseInt(const string &line, int &value) {
    istringstream iss(line);
    string extra;
    return (iss >> value) && !(iss >> extra);
}

